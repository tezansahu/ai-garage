# Bring your own Microsoft Foundry resource. Deploy BOTH models in the same resource:
#   - Microsoft Decision-1 (System One decision model)
#   - gpt-5-mini           (baseline for comparison)
# Both deployments share this resource's key and endpoint. Keys stay on the server.
AZURE_OPENAI_API_KEY=
# Resource endpoint, e.g. https://<your-resource>.services.ai.azure.com
# (any path such as /openai/v1 is ignored; the app derives each model's route)
AZURE_OPENAI_ENDPOINT=

# Deployment names exactly as shown in Foundry > Models + endpoints.
AZURE_DECISION_DEPLOYMENT=Decision-1
AZURE_GPT_DEPLOYMENT=gpt-5-mini

# Optional: Jev is BYO key in the UI, not a shared server credential.
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
